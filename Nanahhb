local isMenuOpen = true

-- Bật/Tắt hiển thị menu chính khi ấn nút tròn
toggleMenuBtn.MouseButton1Click:Connect(function()
    isMenuOpen = not isMenuOpen
    mainFrame.Visible = isMenuOpen
end)

-- Bật nhạc và lặp lại
onBtn.MouseButton1Click:Connect(function()
    local rawText = idTextBox.Text
    local soundIdNumber = rawText:match("%d+") -- Lọc lấy dãy số ID
    
    if soundIdNumber then
        soundObject.SoundId = "rbxassetid://" .. soundIdNumber
        soundObject.Looped = true -- Bật chế độ lặp lại liên tục
        soundObject:Play()
        
        statusLabel.Text = "Trạng thái: Đang phát (Looping)"
        statusLabel.TextColor3 = Color3.fromRGB(46, 204, 113)
    else
        statusLabel.Text = "Trạng thái: Sound ID không hợp lệ!"
        statusLabel.TextColor3 = Color3.fromRGB(231, 76, 60)
    end
end)

-- Tắt nhạc hoàn toàn
offBtn.MouseButton1Click:Connect(function()
    soundObject:Stop()
    soundObject.SoundId = ""
    
    statusLabel.Text = "Trạng thái: Đã tắt"
    statusLabel.TextColor3 = Color3.fromRGB(231, 76, 60)
end)
